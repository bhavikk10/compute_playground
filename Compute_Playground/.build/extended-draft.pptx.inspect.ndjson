{"kind":"textbox","id":"sh/dc3qp4j6","slideIndex":4,"position":{"left":64,"top":210,"width":1140,"height":380},"text":"Same 14 tasks with queue off: 12 completed, 2 rejected.\nQueue on: 13 completed, 1 expired, 0 rejected.\nWaiting counts against each job's response deadline.\nTenant B cannot view or stop Tenant A records.\nTimelines and decision details also enforce ownership.\nStopping a running VM releases resources exactly once.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Aptos","color":"#163343","alignment":"left"}}

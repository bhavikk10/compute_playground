{"kind":"textbox","id":"sh/z21476p0","slideIndex":2,"position":{"left":64,"top":95,"width":1140,"height":90},"text":"Placement and deadlines","geometry":"rect","lineWidth":0,"style":{"fontSize":42,"typeface":"Aptos","color":"#163343","alignment":"left"}}
{"kind":"textbox","id":"sh/y1sne18f","slideIndex":2,"position":{"left":64,"top":210,"width":1140,"height":380},"text":"Latency first minimizes eligible network delay.\nCapacity aware balances response and projected utilization.\nEnergy aware balances response and modeled task energy.\nResponse = waiting + processing + network delay.\nEarliest deadlines get queue priority. Expired jobs never start.\nAll policies must pass CPU, RAM and response checks.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Aptos","color":"#163343","alignment":"left"}}

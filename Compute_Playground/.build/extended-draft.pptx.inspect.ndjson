{"kind":"textbox","id":"sh/nax4ne1c","slideIndex":6,"position":{"left":64,"top":95,"width":1140,"height":90},"text":"Energy assumptions and real resources","geometry":"rect","lineWidth":0,"style":{"fontSize":42,"typeface":"Aptos","color":"#163343","alignment":"left"}}
{"kind":"textbox","id":"sh/m9o3etkr","slideIndex":6,"position":{"left":64,"top":210,"width":1140,"height":380},"text":"Power coefficients are hypothetical: 2 / 6 / 18 W per CPU.\nJoules = CPU x coefficient x processing seconds.\nIdle, network, RAM, cooling and VM boot costs are omitted.\nReal execution requires an unimplemented infrastructure adapter.\nIt must launch, monitor and stop work and reconcile resources.\nDemo identities and predicted durations are not production services.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Aptos","color":"#163343","alignment":"left"}}

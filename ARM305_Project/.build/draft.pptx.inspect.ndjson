{"kind":"textbox","id":"sh/21gnapcf","slideIndex":3,"position":{"left":64,"top":210,"width":570,"height":370},"text":"18 tasks completed under each policy.\nMean response: 68.06 ms latency first, 89.17 ms capacity aware.\nPeak Fog CPU: 100% latency first, 41.67% capacity aware.\nCapacity aware preserves headroom at a response-time cost.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Aptos","color":"#163343","alignment":"left"}}

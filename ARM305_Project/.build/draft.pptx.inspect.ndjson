{"kind":"textbox","id":"sh/ds3udg76","slideIndex":2,"position":{"left":64,"top":95,"width":1140,"height":90},"text":"Placement and virtual time","geometry":"rect","lineWidth":0,"style":{"fontSize":42,"typeface":"Aptos","color":"#163343","alignment":"left"}}
{"kind":"textbox","id":"sh/srutkb6l","slideIndex":2,"position":{"left":64,"top":210,"width":1140,"height":370},"text":"Both policies filter available CPU, RAM and response budgets.\nLatency first minimizes network delay.\nCapacity aware balances response against projected utilization.\nProcessing = work / (CPU x speed).\nResponse = processing + network delay.\nVirtual completion events release resources exactly once.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Aptos","color":"#163343","alignment":"left"}}

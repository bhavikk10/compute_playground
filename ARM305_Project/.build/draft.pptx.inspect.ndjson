{"kind":"textbox","id":"sh/q5ofi147","slideIndex":1,"position":{"left":64,"top":210,"width":1140,"height":370},"text":"Tenant tasks pass through ownership and placement checks.\nEdge: 4 CPU, 4 GB, 5 ms network delay\nFog: 12 CPU, 16 GB, 25 ms network delay\nCloud: 32 CPU, 64 GB, 100 ms network delay\nOne simulated VM reserves resources for each accepted task.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Aptos","color":"#163343","alignment":"left"}}
